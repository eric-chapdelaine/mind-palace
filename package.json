{
  "name": "mind-palace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"pnpm --filter @mind-palace/server dev\" \"pnpm --filter @mind-palace/web dev\"",
    "tui": "pnpm --filter @mind-palace/tui dev",
    "briefing": "pnpm --filter @mind-palace/server exec tsx ../../scripts/print-briefing.ts",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "db:migrate": "pnpm --filter @mind-palace/server db:migrate",
    "test:worker": "uv run --project workers/cp-sat python -m unittest discover -s workers/cp-sat/tests",
    "start": "pnpm --filter @mind-palace/server start"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "typescript": "7.0.2"
  }
}